#!/usr/bin/env bash

set -e

export FPM_USER_ID=${FPM_USER_ID:-$(id -u)}
export FPM_GROUP_ID=${FPM_GROUP_ID:-$(id -g)}
export PHP_VERSION=${PHP_VERSION:-8.1}

CMD=$1

if [ ! -f docker-conf/certs/tests.jelix-CA.crt ]; then
  echo "generate CA certs"
  (
  cd docker-conf
  ./ssl.sh createCA tests.jelix
  )
fi

if [ ! -f docker-conf/certs/ldap.jelix.crt ]; then
  echo "generate certificates for the ldap server"
  (
  cd docker-conf
  ./ssl.sh createCert ldap.jelix tests.jelix
  )
fi

if [ ! -f docker-conf/certs/ad.jelix.crt ]; then
  echo "generate certificates for the Samba Active Directory server"
  (
  cd docker-conf
  ./ssl.sh createCert ad.jelix tests.jelix
  )
fi

if [ ! -f docker-conf/certs/client.jelix.crt ]; then
  echo "generate certificates for the ldap client"
  (
  cd docker-conf
  ./ssl.sh createCert client.jelix tests.jelix
  )
fi

if [ "$CMD" == "reset" ]; then
    # Stop/Remove containers
    docker compose -p jelix-ldap-tests rm -sf || true
    rm -f tests/tmp/ldap_tests.log
    exit 0
elif [ -z "$CMD" ]; then
    CMD="up"
else
    shift
fi

docker compose -p jelix-ldap-tests $CMD
