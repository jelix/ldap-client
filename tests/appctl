#!/usr/bin/env bash

COMMAND="$1"
shift

if [ "$COMMAND" == "" ]; then
    echo "Error: command is missing"
    echo "Possible commands: clean_tmp, reset, install, rights, composer-install, composer-update"
    echo " unit-tests, unit-tests-never, unit-tests-demand, unit-tests-allow"
    echo " shell, shellroot"
    echo " ldapreset, ldapusers"
    exit 1;
fi

CONTAINER_PREFIX=jelix_ldap

case $COMMAND in
    composer-install)
        docker exec -t -i ${CONTAINER_PREFIX}_php appctl.sh composer_install;;
    composer-update)
        docker exec -t -i ${CONTAINER_PREFIX}_php appctl.sh composer_update;;
    unit-tests)
      echo "------ Unit tests against an ldap server that never ask a client certificate"
      #docker exec -it ${CONTAINER_PREFIX}_server /bin/ctl.sh reset
      docker exec -it ${CONTAINER_PREFIX}_server /bin/ctl.sh setup-tls-never
      docker exec -t -i ${CONTAINER_PREFIX}_php appctl.sh unittests --process-isolation --configuration phpunit_never.xml $@
      echo "------ Unit tests against an ldap server that allow a client certificate"
      #docker exec -it ${CONTAINER_PREFIX}_server /bin/ctl.sh reset
      docker exec -it ${CONTAINER_PREFIX}_server /bin/ctl.sh setup-tls-allow
      docker exec -t -i ${CONTAINER_PREFIX}_php appctl.sh unittests --process-isolation --configuration phpunit_allow.xml $@
      echo "------ Unit tests against an ldap server that need a client certificate"
      #docker exec -it ${CONTAINER_PREFIX}_server /bin/ctl.sh reset
      docker exec -it ${CONTAINER_PREFIX}_server /bin/ctl.sh setup-tls-demand
      docker exec -t -i ${CONTAINER_PREFIX}_php appctl.sh unittests --process-isolation --configuration phpunit_demand.xml $@
      ;;
    unit-tests-never)
      echo "------ Unit tests against an ldap server that never ask a client certificate"
      docker exec -it ${CONTAINER_PREFIX}_server /bin/ctl.sh setup-tls-never
      docker exec -t -i ${CONTAINER_PREFIX}_php appctl.sh unittests --process-isolation --configuration phpunit_never.xml $@
      ;;
    unit-tests-demand)
      echo "------ Unit tests against an ldap server that need a client certificate"
      docker exec -it ${CONTAINER_PREFIX}_server /bin/ctl.sh setup-tls-demand
      docker exec -t -i ${CONTAINER_PREFIX}_php appctl.sh unittests --process-isolation --configuration phpunit_demand.xml $@
      ;;
    unit-tests-allow)
      echo "------ Unit tests against an ldap server that allow a client certificate"
      docker exec -it ${CONTAINER_PREFIX}_server /bin/ctl.sh setup-tls-allow
      docker exec -t -i ${CONTAINER_PREFIX}_php appctl.sh unittests --process-isolation --configuration phpunit_allow.xml $@
      ;;
    shell)
       docker exec -it --user userphp ${CONTAINER_PREFIX}_php  /bin/bash -l;;
    shellroot)
       docker exec -it ${CONTAINER_PREFIX}_php  /bin/bash  -l;;
    ldapreset)
      docker exec -it ${CONTAINER_PREFIX}_server /bin/ctl.sh reset
      ;;
    ldapusers)
       docker exec -it ${CONTAINER_PREFIX}_server /bin/ctl.sh showusers
       ;;
    ldapshell)
       docker exec -it ${CONTAINER_PREFIX}_server  /bin/bash -l
     ;;
    ldap-tls-never)
       docker exec -it ${CONTAINER_PREFIX}_server /bin/ctl.sh setup-tls-never
       ;;
    ldap-tls-allow)
       docker exec -it ${CONTAINER_PREFIX}_server /bin/ctl.sh setup-tls-allow
       ;;
    ldap-tls-demand)
       docker exec -it ${CONTAINER_PREFIX}_server /bin/ctl.sh setup-tls-demand
       ;;
    *)
        echo "wrong command"
        exit 2
        ;;
esac
