{
    "name": "jelix/ldap-authentication",
    "type": "library",
    "description": "library to authenticate against a Ldap server",
    "keywords": ["authentication", "jelix"],
    "license": "MIT",
    "authors": [
        {
            "name": "Laurent Jouanneau",
            "email": "laurent@jelix.org"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-ldap": "*",
        "psr/log": "1.*"
    },
    "require-dev" : {
        "phpunit/phpunit" : "~11.5.57"
    },
    "autoload": {
        "psr-4" : {
            "Jelix\\Ldap\\" : "lib/"
        }
    },
    "archive": {
        "exclude": ["/test"]
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.1.x-dev"
        }
    },
    "minimum-stability": "stable"
}
